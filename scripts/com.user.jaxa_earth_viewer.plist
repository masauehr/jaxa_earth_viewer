<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.jaxa_earth_viewer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/masahiro/projects/jaxa_earth_viewer/scripts/daily_update.sh</string>
    </array>

    <!-- 11:00 初回、16:00 リトライ（取得済みの日付はスクリプト側でスキップされ、変更がなければpushしない） -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>11</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/masahiro/projects/jaxa_earth_viewer/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/masahiro/projects/jaxa_earth_viewer/launchd.log</string>
</dict>
</plist>
